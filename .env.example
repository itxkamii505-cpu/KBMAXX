# ---- Required ----
# Admin login: username is FIXED = ITXKAMII. Only the password is configurable.
ADMIN_PASSWORD=change-this-to-a-long-password

# ---- Recommended ----
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TZ=Asia/Karachi
# Extra PIN for sensitive admin actions (the admin password is also accepted)
ADMIN_SECURITY_PIN=
# Webhook token (auto-generated and saved on first run if empty)
WEBHOOK_TOKEN=
# Key used to encrypt client passwords on disk (auto-generated in data/.datakey if empty)
DATA_KEY=
# Extra browser origins allowed to call the API (comma separated). Same-origin always works.
ALLOWED_ORIGIN=
# Optional: WhiteNoise default API key (can also be set from the admin panel)
WHITENOISE_API_KEY=
